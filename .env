ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_USER=system
ORACLE_PASSWORD=dummy

ORACLE_CDB_SERVICE=ORCLCDB.localdomain
ORACLE_DEFAULT_PDB=orclpdb1.localdomain
ORACLE_DSN=localhost:1521/orclpdb1.localdomain
ORACLE_SERVICE_SUFFIX=.localdomain

LLM_PROVIDER=openwebui
LLM_MODEL=openai/gpt-oss-120b
OPENWEBUI_BASE_URL=https://open-webui.ck8s-aiml.zcloud.rch.zai.com/api/v1
OPENWEBUI_API_KEY=dummy

# SSL certs
SSL_CERT_FILE=$HOME/.certs/company-ca.pem
REQUESTS_CA_BUNDLE=$HOME/.certs/company-ca.pem

MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=9000
MCP_PATH=/mcp
MCP_SERVER_URL=http://localhost:9000/mcp

AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8000


AUDIT_LOG_DIR=logs
AUDIT_LOG_FINAL_ANSWER=false

DB_DEBUG=false
